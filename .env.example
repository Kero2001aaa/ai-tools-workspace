# Copy to .env for local development. Never commit real credentials.
# Safe default: leave these blank to run fully offline.
#
# Optional OpenRouter free-model example:
# MODEL_API_KEY=your_openrouter_api_key
# MODEL_BASE_URL=https://openrouter.ai/api/v1
# MODEL_NAME=openrouter/free
#
# openrouter/free automatically routes to an available free model.
# Free model variants are rate-limited. Do not buy credits for this project.
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=

# Optional OmniRoute-compatible gateway. Configure only after deploying/verifying your own gateway.
# The existing model adapter accepts any OpenAI-compatible endpoint.
# MODEL_API_KEY=your_gateway_key
# MODEL_BASE_URL=https://your-verified-gateway-host/v1
# MODEL_NAME=your-configured-model-or-route
# Keep paid fallback/providers disabled for this zero-budget workspace.

# Optional web research. Free allowances are limited and may change.
# Exa: https://dashboard.exa.ai/
EXA_API_KEY=
# Firecrawl: https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# Optional Playwright browser MCP server. Keep disabled unless installed and needed.
ENABLE_BROWSER_TOOLS=false

# Optional Graphify MCP server. Install with: uv tool install "graphifyy[mcp]"
# Build graphify-out/graph.json, then set its absolute path below.
# The graphify-mcp executable must be available on PATH.
# Leave the graph path blank to keep Graphify disconnected.
GRAPHIFY_MCP_COMMAND=
GRAPHIFY_GRAPH_PATH=

# Optional public-only Agent Reach MCP bridge. Install the pinned uv tool first.
# Exposes anonymous GitHub REST API and public V2EX API reads only.
# No login, session reuse, ffmpeg, gh, or extra channel tools are required.
ENABLE_AGENT_REACH_TOOLS=false
AGENT_REACH_COMMAND=

# Local service defaults
WORKSPACE_HOST=0.0.0.0
WORKSPACE_PORT=8000

# Approximate context budget for the tool-calling agent (not a provider limit).
AGENT_CONTEXT_TOKEN_BUDGET=6000
AGENT_CONTEXT_RESERVED_TOKENS=1200

# Explicit opt-in for authenticated dashboard-to-Agent requests; may use provider quota/billing.
ENABLE_DASHBOARD_AGENT=false
