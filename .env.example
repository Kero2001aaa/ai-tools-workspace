# Copy to .env for local development. Never commit real credentials.
# Safe default: leave these blank to run fully offline.
#
# Optional OpenRouter free-model example:
# MODEL_API_KEY=your_openrouter_api_key
# MODEL_BASE_URL=https://openrouter.ai/api/v1
# MODEL_NAME=openrouter/free
#
# openrouter/free automatically routes to an available free model.
# Free model variants are rate-limited. Do not buy credits for this project.
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=

# Optional research-provider credentials; may incur charges.
EXA_API_KEY=
FIRECRAWL_API_KEY=

# Local service defaults
WORKSPACE_HOST=0.0.0.0
WORKSPACE_PORT=8000
